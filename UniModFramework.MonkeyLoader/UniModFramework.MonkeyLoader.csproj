<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Langversion>14</Langversion>
    <RepositoryUrl>https://github.com/Nytra/UniModFramework</RepositoryUrl>
    <PackageId>Nytra.UniModFramework.MonkeyLoader</PackageId>
    <Product>UniModFramework.MonkeyLoader</Product>
    <RootNamespace>UniModFramework</RootNamespace>
    <AssemblyName>UniModFramework</AssemblyName>
    <GeneratePackageOnBuild>$(CopyToPlugins)</GeneratePackageOnBuild>
    <PackageOutputPath>$(GamePath)MonkeyLoader/Libs/</PackageOutputPath>
  </PropertyGroup>

  <!-- Local game references -->
  <ItemGroup>
    <PackageReference Include="MonkeyLoader.GamePacks.Resonite" Version="0.33.0" GeneratePathProperty="true" />

    <Reference Include="MonkeyLoader.Resonite.Data" PrivateAssets="all">
      <HintPath>$(PkgMonkeyLoader_GamePacks_Resonite)\lib\net10.0\pre-patchers\MonkeyLoader.Resonite.Data.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/*.cs"  />
  </ItemGroup>
</Project>
