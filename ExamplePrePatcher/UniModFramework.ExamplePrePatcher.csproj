<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Langversion>14</Langversion>
    <RepositoryUrl>https://github.com/Nytra/UniModFramework</RepositoryUrl>
    <PackageId>Nytra.UniModFramework.ExamplePrePatcher</PackageId>
    <Product>UniModFramework.ExamplePrePatcher</Product>
    <RootNamespace>UniModFramework.ExamplePrePatcher</RootNamespace>
    <GeneratePackageOnBuild>$(CopyToPlugins)</GeneratePackageOnBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageOutputPath>$(GamePath)MonkeyLoader/Mods/</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The installed loader backend provides UniModFramework.dll, so it isn't copied or added as a package dependency -->
    <ProjectReference Include="../UniModFramework/UniModFramework.csproj" Private="false" PrivateAssets="all" />
    <!-- For the patch methods, MonkeyLoader and BepisLoader ship this version -->
    <PackageReference Include="Mono.Cecil" Version="0.11.6" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="lib/$(TargetFramework)/pre-patchers/"/>
  </ItemGroup>  

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <PluginFiles Include="$(TargetPath)" />
    </ItemGroup>
  
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="../out/" />
    <Message Text="Copied plugin files to out dir" Importance="high" />
    
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(GamePath)rml_mods/" Condition="'$(CopyToPlugins)' == 'true'" />
    <Message Text="Copied plugin files to $(GamePath)rml_mods/" Importance="high" Condition="'$(CopyToPlugins)' == 'true'"/>

    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(BepInExProfileDir)BepInEx/patchers/$(AssemblyName)" Condition="'$(CopyToPlugins)' == 'true'" />
    <Message Text="Copied plugin files to $(BepInExProfileDir)BepInEx/patchers/$(AssemblyName)" Importance="high" Condition="'$(CopyToPlugins)' == 'true'"/>
  
    <!-- <Copy SourceFiles="..\..\out\InterprocessLib.FrooxEngine.dll" DestinationFolder="$(LibTargetDir)" Condition="'$(CopyToPlugins)' == 'true'" />
    <Message Text="Copied frooxengine lib to $(LibTargetDir)" Importance="high" Condition="'$(CopyToPlugins)' == 'true'" />
  
    <Copy SourceFiles="..\..\out\InterprocessLib.BepisLoader_Extensions.dll" DestinationFolder="$(LibTargetDir)" Condition="'$(CopyToPlugins)' == 'true'" />
    <Message Text="Copied bepisloader extensions to $(LibTargetDir)" Importance="high" Condition="'$(CopyToPlugins)' == 'true'" />

    <Exec Command="dotnet tool restore" WorkingDirectory="$(SolutionDir)" />
    <Exec Command="dotnet tcli build" WorkingDirectory="$(SolutionDir)" /> -->
  </Target>
</Project>
