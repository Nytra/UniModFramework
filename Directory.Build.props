<Project>

  <!-- Machine-specific settings (GamePath, BepInExProfileDir, CopyToPlugins) go in Directory.Build.props.user, which git ignores -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.props.user" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" />

  <PropertyGroup>
    <!-- Bump this for each release, mods built against a newer version won't load on an older one -->
    <Version>1.0.0</Version>
    <Authors>Nytra</Authors>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>Nullable</WarningsAsErrors>
    <Deterministic>true</Deterministic>
    <GamePath Condition="'$(GamePath)' == '' and '$(ResonitePath)' != ''">$(ResonitePath)/</GamePath>
    <GamePath Condition="'$(GamePath)' == '' and Exists('$(MSBuildProgramFiles32)\Steam\steamapps\common\Resonite\')">$(MSBuildProgramFiles32)\Steam\steamapps\common\Resonite\</GamePath>
    <GamePath Condition="'$(GamePath)' == '' and Exists('$(HOME)/.steam/steam/steamapps/common/Resonite/')">$(HOME)/.steam/steam/steamapps/common/Resonite/</GamePath>
    <GamePath Condition="'$(GamePath)' == '' and Exists('$(HOME)/snap/steam/common/.local/share/Steam/steamapps/common/Resonite/')">$(HOME)/snap/steam/common/.local/share/Steam/steamapps/common/Resonite/</GamePath>
    <!-- Copies builds into the game and mod loader folders -->
    <CopyToPlugins Condition="'$(CopyToPlugins)' == ''">false</CopyToPlugins>
  </PropertyGroup>
</Project>